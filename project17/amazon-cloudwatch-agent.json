{
  "agent": {
    "region": "ap-south-1",
    "logfile": "/opt/aws/amazon-cloudwatch-agent/logs/amazon-cloudwatch-agent.log"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/syslog",
            "log_group_name": "/capstone/suryaansh/syslog",
            "log_stream_name": "{hostname}-syslog",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/nginx/access.log",
            "log_group_name": "/capstone/suryaansh/nginx-access",
            "log_stream_name": "{hostname}-nginx",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
